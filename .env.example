DATABASE_URL=postgresql+asyncpg://editorial:editorial@localhost:5432/editorial
OPENAI_API_KEY=your-gemini-api-key-from-ai-studio
OPENAI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
ENV=dev
# comma-separated list of allowed frontend origins (CORS)
ALLOWED_ORIGINS=http://localhost:3000
# Tavily search API (free tier, ~1000 searches/month) - used by the research agent
TAVILY_API_KEY=your-tavily-api-key
# max tool calls (search/fetch) the research agent makes before it's forced to finish
RESEARCH_MAX_TOOL_CALLS=6
# Langfuse tracing (optional) - leave blank to disable, tracing is skipped silently
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
